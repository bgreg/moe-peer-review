        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate-moe-agent-output.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
